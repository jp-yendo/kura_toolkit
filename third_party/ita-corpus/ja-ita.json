{
 "language": "ja",
 "name": "ITA corpus",
 "source": "https://github.com/mmorise/ita-corpus",
 "license": "Public Domain (Unlicense)",
 "sentences": [
  {
   "id": "EMOTION100_001",
   "set": "emotion",
   "text": "えっ嘘でしょ。"
  },
  {
   "id": "EMOTION100_002",
   "set": "emotion",
   "text": "シュヴァイツァーは見習うべき人間です。"
  },
  {
   "id": "EMOTION100_003",
   "set": "emotion",
   "text": "デーヴィスさんはとても疲れているように見える。"
  },
  {
   "id": "EMOTION100_004",
   "set": "emotion",
   "text": "スティーヴはジェーンから手紙をもらった。"
  },
  {
   "id": "EMOTION100_005",
   "set": "emotion",
   "text": "彼女はモーツァルトやベートーヴェンといった、古典派の作曲家が好きだ。"
  },
  {
   "id": "EMOTION100_006",
   "set": "emotion",
   "text": "ストラットフォード・オン・エイヴォンは、シェイクスピアの生まれたところですが、毎年多くの観光客が訪れます。"
  },
  {
   "id": "EMOTION100_007",
   "set": "emotion",
   "text": "彼はピューマを慣らすのに、大いに骨を折った。"
  },
  {
   "id": "EMOTION100_008",
   "set": "emotion",
   "text": "彼が解雇されるとは妙な話だ。"
  },
  {
   "id": "EMOTION100_009",
   "set": "emotion",
   "text": "クリスはヴァンパイア・ナイトを倒した。"
  },
  {
   "id": "EMOTION100_010",
   "set": "emotion",
   "text": "彼のあだ名は言い得て妙だよね。"
  },
  {
   "id": "EMOTION100_011",
   "set": "emotion",
   "text": "イタリア旅行で彼は、いくつか景勝の地として有名な都市、例えば、ナポリやフィレンツェを訪れた。"
  },
  {
   "id": "EMOTION100_012",
   "set": "emotion",
   "text": "ゼロという概念は、ヒンドゥー文化に由来している。"
  },
  {
   "id": "EMOTION100_013",
   "set": "emotion",
   "text": "そのいたずら娘は何食わぬ顔をした。"
  },
  {
   "id": "EMOTION100_014",
   "set": "emotion",
   "text": "スミスさん、ピエール・デュボワをご紹介しますわ。私の親友なの。"
  },
  {
   "id": "EMOTION100_015",
   "set": "emotion",
   "text": "どーすんの、このお店。完ッ全に閑古鳥が鳴いちゃってるじゃない。"
  },
  {
   "id": "EMOTION100_016",
   "set": "emotion",
   "text": "頂上に着くと皆でヤッホーと叫んだ。"
  },
  {
   "id": "EMOTION100_017",
   "set": "emotion",
   "text": "あっベルが鳴ってる。"
  },
  {
   "id": "EMOTION100_018",
   "set": "emotion",
   "text": "彼女は彼にぴょこんとおじぎをした。"
  },
  {
   "id": "EMOTION100_019",
   "set": "emotion",
   "text": "男子生徒のめいめいが、帽子に学校のバッジをつけています。"
  },
  {
   "id": "EMOTION100_020",
   "set": "emotion",
   "text": "ヒューズが飛んだ。"
  },
  {
   "id": "EMOTION100_021",
   "set": "emotion",
   "text": "私はポピュラー音楽を聞きたい。"
  },
  {
   "id": "EMOTION100_022",
   "set": "emotion",
   "text": "猫はにゃーにゃーと鳴く。"
  },
  {
   "id": "EMOTION100_023",
   "set": "emotion",
   "text": "私の一番上の兄が父の名代としてその会合に出席した。"
  },
  {
   "id": "EMOTION100_024",
   "set": "emotion",
   "text": "彼は首相にインタビューした。"
  },
  {
   "id": "EMOTION100_025",
   "set": "emotion",
   "text": "その会社の急速な成長は、その独特な戦略によるものだった。"
  },
  {
   "id": "EMOTION100_026",
   "set": "emotion",
   "text": "私はいつもミネラルウォーターを持ち歩いています。"
  },
  {
   "id": "EMOTION100_027",
   "set": "emotion",
   "text": "彼女はハンドバッグを開けて家の鍵を探してみたが、見つからなかった。"
  },
  {
   "id": "EMOTION100_028",
   "set": "emotion",
   "text": "彼女はスタッフをまとめていけると思いますか？"
  },
  {
   "id": "EMOTION100_029",
   "set": "emotion",
   "text": "牛乳はあなたの体に良いだろう、毎日飲んだほうがいい。"
  },
  {
   "id": "EMOTION100_030",
   "set": "emotion",
   "text": "あなたは流感になりかけているか、もっと重い病気かもしれません。"
  },
  {
   "id": "EMOTION100_031",
   "set": "emotion",
   "text": "彼女はその事件を、生き生きとした筆致で描写した。"
  },
  {
   "id": "EMOTION100_032",
   "set": "emotion",
   "text": "彼は自らの生涯を、インドでの病人の治療に捧げるつもりだ。"
  },
  {
   "id": "EMOTION100_033",
   "set": "emotion",
   "text": "奇妙な男で、彼は人から話し掛けられないと口をきかない。"
  },
  {
   "id": "EMOTION100_034",
   "set": "emotion",
   "text": "我々はその山脈で土着のガイドを雇った。"
  },
  {
   "id": "EMOTION100_035",
   "set": "emotion",
   "text": "彼女は息子に家で行儀よくするように言った。"
  },
  {
   "id": "EMOTION100_036",
   "set": "emotion",
   "text": "彼はライフルを拾い上げ、それで標的をねらった。"
  },
  {
   "id": "EMOTION100_037",
   "set": "emotion",
   "text": "私はこの本に八百円を払った。"
  },
  {
   "id": "EMOTION100_038",
   "set": "emotion",
   "text": "気分が悪くて入院したが、結果的にはたいしたことはなかった。"
  },
  {
   "id": "EMOTION100_039",
   "set": "emotion",
   "text": "アフィ狙いの釣り記事ですね。英語関係のコミュのあちこちにマルチポストしています。"
  },
  {
   "id": "EMOTION100_040",
   "set": "emotion",
   "text": "トラベラーズチェックを現金に替えてくれるのはこの窓口ですか？"
  },
  {
   "id": "EMOTION100_041",
   "set": "emotion",
   "text": "本日の映画は、サウンド・オブ・ミュージックでございます。"
  },
  {
   "id": "EMOTION100_042",
   "set": "emotion",
   "text": "概してわれわれ日本人は、外国語を話すのに少し臆病すぎる。"
  },
  {
   "id": "EMOTION100_043",
   "set": "emotion",
   "text": "店の人は私のことを知るようになり、私はいつも同じウェイトレスに応対してもらっていた。"
  },
  {
   "id": "EMOTION100_044",
   "set": "emotion",
   "text": "この丘からは何百万という星が見える。"
  },
  {
   "id": "EMOTION100_045",
   "set": "emotion",
   "text": "彼女は大学に入学したら、親から経済的に独立しようと思っていた。"
  },
  {
   "id": "EMOTION100_046",
   "set": "emotion",
   "text": "サブマリンのペリスコープが、水中からにょっきり突き出ていた。"
  },
  {
   "id": "EMOTION100_047",
   "set": "emotion",
   "text": "別にブルマに特別な関心があるわけじゃない。"
  },
  {
   "id": "EMOTION100_048",
   "set": "emotion",
   "text": "そういうフェティシズムはないと思う。"
  },
  {
   "id": "EMOTION100_049",
   "set": "emotion",
   "text": "ウッド夫人が作ってくれるおいしい田舎風の料理を食べたし、ミルクをたくさん飲みました。"
  },
  {
   "id": "EMOTION100_050",
   "set": "emotion",
   "text": "私の妻が瓶をわってしまったので、台所の床は牛乳だらけになっている。"
  },
  {
   "id": "EMOTION100_051",
   "set": "emotion",
   "text": "喧嘩をしていた二人の子供は、お互いにしかめっ面をして座っていた。"
  },
  {
   "id": "EMOTION100_052",
   "set": "emotion",
   "text": "事業を継続しながら、事業が依拠している不動産を、切り売りしていくことなど非現実的なのだ。"
  },
  {
   "id": "EMOTION100_053",
   "set": "emotion",
   "text": "しかしペパーバーグは、そのオウムを研究することによって、動物に対する考え方が変わったと言っている。"
  },
  {
   "id": "EMOTION100_054",
   "set": "emotion",
   "text": "パックマンがある条件を満たすと、追ってくるモンスターを逆襲して食べることができる。"
  },
  {
   "id": "EMOTION100_055",
   "set": "emotion",
   "text": "その数百年後に、フォークが西洋のテーブルに現れることになるが、ただちに受け入れられたわけではなかった。"
  },
  {
   "id": "EMOTION100_056",
   "set": "emotion",
   "text": "トップのリーダーは犬の行動学ではアルファと呼ばれ、以下ベータ、ガンマと続きます。"
  },
  {
   "id": "EMOTION100_057",
   "set": "emotion",
   "text": "ウィーンまでは歩くとどのくらいかかりますか？"
  },
  {
   "id": "EMOTION100_058",
   "set": "emotion",
   "text": "すみません、この辺に詳しくないんです。"
  },
  {
   "id": "EMOTION100_059",
   "set": "emotion",
   "text": "目標は授業設計をするときの、学生の思考を触発するメディア教材の選択および、活用方法について理解することである。"
  },
  {
   "id": "EMOTION100_060",
   "set": "emotion",
   "text": "とりあえず店の前、掃除しといてくれ。打ち水も頼む。"
  },
  {
   "id": "EMOTION100_061",
   "set": "emotion",
   "text": "人々はトーナメントが始まる何ヶ月も前に、これらの入場券を買う。"
  },
  {
   "id": "EMOTION100_062",
   "set": "emotion",
   "text": "彼女の魅力は言葉では表現できない、とその芸術家は叫んだ。"
  },
  {
   "id": "EMOTION100_063",
   "set": "emotion",
   "text": "事象として簡単なことを、いかにも難しそうに表現する人は、あまり頭がよさそうではない。"
  },
  {
   "id": "EMOTION100_064",
   "set": "emotion",
   "text": "デザインも、アーチ型のロゴデザインにより、現代的で登場感、躍動感あるものに仕上げました。"
  },
  {
   "id": "EMOTION100_065",
   "set": "emotion",
   "text": "そんなに慌てて運転して、一体どこへ行こうってんだよ。"
  },
  {
   "id": "EMOTION100_066",
   "set": "emotion",
   "text": "時間はあるんだから、安全運転してくれよ。"
  },
  {
   "id": "EMOTION100_067",
   "set": "emotion",
   "text": "ディスプレイはモニタともいい、コンピュータなどの機器から出力される静止画、または動画の映像信号を表示する機器である。"
  },
  {
   "id": "EMOTION100_068",
   "set": "emotion",
   "text": "撃ち合いが少し静まったとき、パパが走ってフラットに行って、私たちにサンドイッチを持ってきてくれたわ。"
  },
  {
   "id": "EMOTION100_069",
   "set": "emotion",
   "text": "ギリシャのフットボールの試合では、一方のチームの選手は、相手チームの陣地のラインの向こう側にボールを持ち込もうとしたのです。"
  },
  {
   "id": "EMOTION100_070",
   "set": "emotion",
   "text": "泳者のシンディー・ニコラスは、へとへとになって泳ぎ切った後、ドーバーでかろうじて陸に上がってきたが、海峡水泳協会のスポークスマンは、彼女がとても元気であると発表した。"
  },
  {
   "id": "EMOTION100_071",
   "set": "emotion",
   "text": "若い男女が人里離れた洋館で恐怖の一夜を過ごすという、ホラーの定番スタイルだ。"
  },
  {
   "id": "EMOTION100_072",
   "set": "emotion",
   "text": "一つには、西洋人ではない人々が自分たち独自の文化に誇りを持ち始めてきたためと、また一つには、フォークを使わないそれらの地域は最も高い出生率の地域を抱えているという理由から、このことは当たっている。"
  },
  {
   "id": "EMOTION100_073",
   "set": "emotion",
   "text": "私たちは恐怖の中で生きていて、苦しんでいるの。"
  },
  {
   "id": "EMOTION100_074",
   "set": "emotion",
   "text": "太陽も花も楽しめないし、私たちの子供時代も楽しめないのよ。"
  },
  {
   "id": "EMOTION100_075",
   "set": "emotion",
   "text": "弊社のエンジニアが日本国内で販売されている同様の製品と仕様を比較した結果、非常に競合力があると判断いたしました。"
  },
  {
   "id": "EMOTION100_076",
   "set": "emotion",
   "text": "ノースウエスタン大学の研究者、アイリーン・ペパーバーグは、オウムは人の口まねをするだけでなく言葉の意味を学ぶことができることを発見しつつある。"
  },
  {
   "id": "EMOTION100_077",
   "set": "emotion",
   "text": "名前をテョといいます。"
  },
  {
   "id": "EMOTION100_078",
   "set": "emotion",
   "text": "ぴゅうぴゅう風が吹きこんでくる。"
  },
  {
   "id": "EMOTION100_079",
   "set": "emotion",
   "text": "キェー。ギェー。イェーイ。"
  },
  {
   "id": "EMOTION100_080",
   "set": "emotion",
   "text": "ひぇーん。びぇーん。ぴぇーん。"
  },
  {
   "id": "EMOTION100_081",
   "set": "emotion",
   "text": "プリミェー。ミェルン。ニェン。"
  },
  {
   "id": "EMOTION100_082",
   "set": "emotion",
   "text": "ステューデント。ダブルデュアル。"
  },
  {
   "id": "EMOTION100_083",
   "set": "emotion",
   "text": "エテュード。エデュケーショナル。サブスティテューション。"
  },
  {
   "id": "EMOTION100_084",
   "set": "emotion",
   "text": "ジャデャクシュ。"
  },
  {
   "id": "EMOTION100_085",
   "set": "emotion",
   "text": "ブレンドデョート。"
  },
  {
   "id": "EMOTION100_086",
   "set": "emotion",
   "text": "イデュスルファーゼ。"
  },
  {
   "id": "EMOTION100_087",
   "set": "emotion",
   "text": "あっあの。"
  },
  {
   "id": "EMOTION100_088",
   "set": "emotion",
   "text": "いっいえ。"
  },
  {
   "id": "EMOTION100_089",
   "set": "emotion",
   "text": "えっえぇ。"
  },
  {
   "id": "EMOTION100_090",
   "set": "emotion",
   "text": "おっおい。"
  },
  {
   "id": "EMOTION100_091",
   "set": "emotion",
   "text": "んーとね。"
  },
  {
   "id": "EMOTION100_092",
   "set": "emotion",
   "text": "アンツィオ。"
  },
  {
   "id": "EMOTION100_093",
   "set": "emotion",
   "text": "エンツォ。"
  },
  {
   "id": "EMOTION100_094",
   "set": "emotion",
   "text": "カートゥーン。"
  },
  {
   "id": "EMOTION100_095",
   "set": "emotion",
   "text": "スィーディー。"
  },
  {
   "id": "EMOTION100_096",
   "set": "emotion",
   "text": "ズィーブラ。"
  },
  {
   "id": "EMOTION100_097",
   "set": "emotion",
   "text": "デピュティーガバナー。"
  },
  {
   "id": "EMOTION100_098",
   "set": "emotion",
   "text": "エリュシオン。"
  },
  {
   "id": "EMOTION100_099",
   "set": "emotion",
   "text": "ガリェント。"
  },
  {
   "id": "EMOTION100_100",
   "set": "emotion",
   "text": "ラーテャン。"
  },
  {
   "id": "RECITATION324_001",
   "set": "recitation",
   "text": "女の子がキッキッ嬉しそう。"
  },
  {
   "id": "RECITATION324_002",
   "set": "recitation",
   "text": "ツァツォに旅行した。"
  },
  {
   "id": "RECITATION324_003",
   "set": "recitation",
   "text": "民衆がテュルリー宮殿に侵入した。"
  },
  {
   "id": "RECITATION324_004",
   "set": "recitation",
   "text": "ハイチ共和国でトゥーサンルーヴェルテュールが勝利を収められたのは、実際黄熱病のおかげだった。"
  },
  {
   "id": "RECITATION324_005",
   "set": "recitation",
   "text": "レジャンドルは民衆をテュルリー宮殿に招いた。"
  },
  {
   "id": "RECITATION324_006",
   "set": "recitation",
   "text": "助言はできないとデュパンは言った。"
  },
  {
   "id": "RECITATION324_007",
   "set": "recitation",
   "text": "フランス人シェフと日本人シェフは全然違う。"
  },
  {
   "id": "RECITATION324_008",
   "set": "recitation",
   "text": "中国の外交団にアタッシェとして派遣された。"
  },
  {
   "id": "RECITATION324_009",
   "set": "recitation",
   "text": "ファシズム勢力との総力戦に臨む。"
  },
  {
   "id": "RECITATION324_010",
   "set": "recitation",
   "text": "家具商人のフィシェルは、荷車と仔馬を貸してくれた。"
  },
  {
   "id": "RECITATION324_011",
   "set": "recitation",
   "text": "ローカル路線にはファンも多い。"
  },
  {
   "id": "RECITATION324_012",
   "set": "recitation",
   "text": "フェイントで相手をかわしてからシュートでフィニッシュした。"
  },
  {
   "id": "RECITATION324_013",
   "set": "recitation",
   "text": "1877、プフェファーにより浸透現象が発見された。"
  },
  {
   "id": "RECITATION324_014",
   "set": "recitation",
   "text": "揺れるフェリーに乗るのは私にとって苦行です。"
  },
  {
   "id": "RECITATION324_015",
   "set": "recitation",
   "text": "ホルロ・アラ・ティタルッフォという特別なお料理も出ました。"
  },
  {
   "id": "RECITATION324_016",
   "set": "recitation",
   "text": "笛の音がなるとウサギのキッドが早速ぴょんと跳ねた。"
  },
  {
   "id": "RECITATION324_017",
   "set": "recitation",
   "text": "あの旅客は噂のキャフェに行くようです。"
  },
  {
   "id": "RECITATION324_018",
   "set": "recitation",
   "text": "目標は一等賞です。"
  },
  {
   "id": "RECITATION324_019",
   "set": "recitation",
   "text": "ウサギのキッドは気分よくピョン、またピョンと飛び続けた。"
  },
  {
   "id": "RECITATION324_020",
   "set": "recitation",
   "text": "アフタヌーンティーを楽しみましょう。"
  },
  {
   "id": "RECITATION324_021",
   "set": "recitation",
   "text": "彼女はティピカルなフェミニストです。"
  },
  {
   "id": "RECITATION324_022",
   "set": "recitation",
   "text": "助手たちとミッツィは探している書類を見つけられなかった。"
  },
  {
   "id": "RECITATION324_023",
   "set": "recitation",
   "text": "フィレンツェ、パドヴァ、ヴェネツィアはどれもイタリアの都市です。"
  },
  {
   "id": "RECITATION324_024",
   "set": "recitation",
   "text": "楽譜に次のように書いてあるのが、エーフェリチェです。"
  },
  {
   "id": "RECITATION324_025",
   "set": "recitation",
   "text": "ショペンハウエルとニーチェの哲学書を本棚から取り出した。"
  },
  {
   "id": "RECITATION324_026",
   "set": "recitation",
   "text": "早速召使い全員に知らせましょう。"
  },
  {
   "id": "RECITATION324_027",
   "set": "recitation",
   "text": "重い綿入を脱いで、あわせに着替える。"
  },
  {
   "id": "RECITATION324_028",
   "set": "recitation",
   "text": "ボストンで、とあるチョプスイ屋へ入って夕飯を食った。"
  },
  {
   "id": "RECITATION324_029",
   "set": "recitation",
   "text": "ろくすっぽ休憩をとらず働いた。"
  },
  {
   "id": "RECITATION324_030",
   "set": "recitation",
   "text": "かつて一人で国府に侵入した。"
  },
  {
   "id": "RECITATION324_031",
   "set": "recitation",
   "text": "だが、今日お前がここへ御入来になったのは、どんなご用なのかな？"
  },
  {
   "id": "RECITATION324_032",
   "set": "recitation",
   "text": "サブフランチャイザーを増やして目指せ百店舗。"
  },
  {
   "id": "RECITATION324_033",
   "set": "recitation",
   "text": "四国でお遍路を行脚しよう。"
  },
  {
   "id": "RECITATION324_034",
   "set": "recitation",
   "text": "いつもの通りギャンギャン泣き出しました。"
  },
  {
   "id": "RECITATION324_035",
   "set": "recitation",
   "text": "先生は、立ったままニュースを見ていました。"
  },
  {
   "id": "RECITATION324_036",
   "set": "recitation",
   "text": "私はギョッと目を見開いた。"
  },
  {
   "id": "RECITATION324_037",
   "set": "recitation",
   "text": "友達へニューイヤーカードを送ろう。"
  },
  {
   "id": "RECITATION324_038",
   "set": "recitation",
   "text": "家政婦は休みにおしゃれなアウターウェアに身を包み一人で屋台を楽しみました。"
  },
  {
   "id": "RECITATION324_039",
   "set": "recitation",
   "text": "ウォッカのお供には塩漬けのきゅうりがあいます。"
  },
  {
   "id": "RECITATION324_040",
   "set": "recitation",
   "text": "山の向こうのミュンヒェンの人たちが攻撃をしかけた。"
  },
  {
   "id": "RECITATION324_041",
   "set": "recitation",
   "text": "ボスニア国境からの攻撃により、十一月にヴァリェヴォが占領された。"
  },
  {
   "id": "RECITATION324_042",
   "set": "recitation",
   "text": "シルヴィウスはデュボアと呼ばれていたフランスのユグノーの家に生まれた。"
  },
  {
   "id": "RECITATION324_043",
   "set": "recitation",
   "text": "そのほかに私に出来ることはなかったのです、百合枝は涙声になった。"
  },
  {
   "id": "RECITATION324_044",
   "set": "recitation",
   "text": "ガル博士百体近く。"
  },
  {
   "id": "RECITATION324_045",
   "set": "recitation",
   "text": "日本政府からの百兆円を超える予算要求。"
  },
  {
   "id": "RECITATION324_046",
   "set": "recitation",
   "text": "写経の美しさに私は仰天してしまった。"
  },
  {
   "id": "RECITATION324_047",
   "set": "recitation",
   "text": "ソプラノ歌手ポリランダチョは歌劇アイーダの特別名歌手と評判です。"
  },
  {
   "id": "RECITATION324_048",
   "set": "recitation",
   "text": "貴方には最初百ポンド渡します。"
  },
  {
   "id": "RECITATION324_049",
   "set": "recitation",
   "text": "社長からの指示です。"
  },
  {
   "id": "RECITATION324_050",
   "set": "recitation",
   "text": "どうも気まぐれというものは多少メフィスティックなものであるらしい。"
  },
  {
   "id": "RECITATION324_051",
   "set": "recitation",
   "text": "蛙がピョコピョコ飛び回っています。"
  },
  {
   "id": "RECITATION324_052",
   "set": "recitation",
   "text": "魔境に足を踏み入れる。"
  },
  {
   "id": "RECITATION324_053",
   "set": "recitation",
   "text": "ヴァンダーヴォットタイム中は、いわゆるパーティーのようで晴れやかです。"
  },
  {
   "id": "RECITATION324_054",
   "set": "recitation",
   "text": "スピリッツとは蒸留酒の事です。"
  },
  {
   "id": "RECITATION324_055",
   "set": "recitation",
   "text": "ヌルシアのベネディクトゥスはアポロン神殿を壊し、ベネディクト会の修道院を建てた。"
  },
  {
   "id": "RECITATION324_056",
   "set": "recitation",
   "text": "ちょうどそのとき、デストゥパーゴがコップをもって立ちあがりました。"
  },
  {
   "id": "RECITATION324_057",
   "set": "recitation",
   "text": "パフィーのグッズが残らず部屋に落ち着いた。"
  },
  {
   "id": "RECITATION324_058",
   "set": "recitation",
   "text": "エピファーノフは財布を無くした。"
  },
  {
   "id": "RECITATION324_059",
   "set": "recitation",
   "text": "ポピュラーなソフトを使いセキュアな状態を復旧する。"
  },
  {
   "id": "RECITATION324_060",
   "set": "recitation",
   "text": "チョコの在庫あったかな？"
  },
  {
   "id": "RECITATION324_061",
   "set": "recitation",
   "text": "おめえ、この仕込みにゃあ、どのくれえ時間かかるか知ってっか。"
  },
  {
   "id": "RECITATION324_062",
   "set": "recitation",
   "text": "それに、このほうが体のためにゃずっといいんだからね。"
  },
  {
   "id": "RECITATION324_063",
   "set": "recitation",
   "text": "夏休みに、トラアヴェミュンへ旅行した。"
  },
  {
   "id": "RECITATION324_064",
   "set": "recitation",
   "text": "ここで一緒にウェイクフィールドの叔母を待った。"
  },
  {
   "id": "RECITATION324_065",
   "set": "recitation",
   "text": "八つになるウォルターと一緒に出た兄弟がいたが、ウォルターだけ発見された。"
  },
  {
   "id": "RECITATION324_066",
   "set": "recitation",
   "text": "最初のジョブはウォーリアがいいと思います。"
  },
  {
   "id": "RECITATION324_067",
   "set": "recitation",
   "text": "およそ六百メートル先を右折です。"
  },
  {
   "id": "RECITATION324_068",
   "set": "recitation",
   "text": "新店オープンのレセプションに沢山のお客さんを招待した。"
  },
  {
   "id": "RECITATION324_069",
   "set": "recitation",
   "text": "脚本作者ピエール・オービュルナンの給仕クレマンが、主人の書斎の戸を大切そうに開いた。"
  },
  {
   "id": "RECITATION324_070",
   "set": "recitation",
   "text": "われわれは、天主教徒か長老教会派のもので、天主教徒が多数を占めている。"
  },
  {
   "id": "RECITATION324_071",
   "set": "recitation",
   "text": "結局のところお互い五十歩百歩だ。"
  },
  {
   "id": "RECITATION324_072",
   "set": "recitation",
   "text": "突拍子もない話だが、決して嘘ではない。"
  },
  {
   "id": "RECITATION324_073",
   "set": "recitation",
   "text": "ネットで懸案の解決を目指す。"
  },
  {
   "id": "RECITATION324_074",
   "set": "recitation",
   "text": "切れ味鋭いペティナイフは使い勝手が良い。"
  },
  {
   "id": "RECITATION324_075",
   "set": "recitation",
   "text": "指をくわえてぴゅーと一声口笛を吹いた。"
  },
  {
   "id": "RECITATION324_076",
   "set": "recitation",
   "text": "クレンペ教頭は無骨な男だが、自分の学問の秘密には深く浸っていた。"
  },
  {
   "id": "RECITATION324_077",
   "set": "recitation",
   "text": "尻尾ふりたて、ひげくいそらす。"
  },
  {
   "id": "RECITATION324_078",
   "set": "recitation",
   "text": "すべての獲物を望みどおりに狙う技術がある。"
  },
  {
   "id": "RECITATION324_079",
   "set": "recitation",
   "text": "タコのグニャグニャした感触が嫌だ。"
  },
  {
   "id": "RECITATION324_080",
   "set": "recitation",
   "text": "私たちは、抽象的意識的自己を否定することで、本当の自己とは身心一如だということを知る。"
  },
  {
   "id": "RECITATION324_081",
   "set": "recitation",
   "text": "鹿島明神が釘で刺し貫いて、魚が動かないようにしている。"
  },
  {
   "id": "RECITATION324_082",
   "set": "recitation",
   "text": "私は手始めに、同業者から話を聞く努力をした。"
  },
  {
   "id": "RECITATION324_083",
   "set": "recitation",
   "text": "とてもうれしそうにぴょんぴょん跳ねて出ていった。"
  },
  {
   "id": "RECITATION324_084",
   "set": "recitation",
   "text": "二分だけのオルガン演奏で終わってしまった。"
  },
  {
   "id": "RECITATION324_085",
   "set": "recitation",
   "text": "ニセ教会に騙されるな。"
  },
  {
   "id": "RECITATION324_086",
   "set": "recitation",
   "text": "およそ百年前には、薬剤として薬屋で売っていた。"
  },
  {
   "id": "RECITATION324_087",
   "set": "recitation",
   "text": "いっそ脚本家を目指した方がいいかとも考えた。"
  },
  {
   "id": "RECITATION324_088",
   "set": "recitation",
   "text": "この書物に誤謬があっても、純一でない何ものにもインフェクトしないでしょう。"
  },
  {
   "id": "RECITATION324_089",
   "set": "recitation",
   "text": "仏教はインド由来の宗教です。"
  },
  {
   "id": "RECITATION324_090",
   "set": "recitation",
   "text": "キャリーバッグは旅行に必須。"
  },
  {
   "id": "RECITATION324_091",
   "set": "recitation",
   "text": "本番前はメチャメチャ不安になる。"
  },
  {
   "id": "RECITATION324_092",
   "set": "recitation",
   "text": "三角関数においてピュタゴラスの定理は必須です。"
  },
  {
   "id": "RECITATION324_093",
   "set": "recitation",
   "text": "著名なラニョン博士が患者と接していた。"
  },
  {
   "id": "RECITATION324_094",
   "set": "recitation",
   "text": "おもちゃの刀を持った少年が、お百度石に寄りかかっている。"
  },
  {
   "id": "RECITATION324_095",
   "set": "recitation",
   "text": "食料の補給が急務であると伝えられた。"
  },
  {
   "id": "RECITATION324_096",
   "set": "recitation",
   "text": "展示会であの作品のみ不評だった。"
  },
  {
   "id": "RECITATION324_097",
   "set": "recitation",
   "text": "客人をもてなすのは当然です。"
  },
  {
   "id": "RECITATION324_098",
   "set": "recitation",
   "text": "旅行客が楽しめるように工夫しましょう。"
  },
  {
   "id": "RECITATION324_099",
   "set": "recitation",
   "text": "こんな冗談のようなニュースはない。"
  },
  {
   "id": "RECITATION324_100",
   "set": "recitation",
   "text": "小さい星をたくさん描いた、水飲みグラスはよくある。"
  },
  {
   "id": "RECITATION324_101",
   "set": "recitation",
   "text": "柄は、猫の尻尾でもあるように、尖端をぶるぶると震わせながら、動いていく。"
  },
  {
   "id": "RECITATION324_102",
   "set": "recitation",
   "text": "開店当初プリンが一番売れていた。"
  },
  {
   "id": "RECITATION324_103",
   "set": "recitation",
   "text": "ロナルドホープ大尉が大将のマンションへ急行しました。"
  },
  {
   "id": "RECITATION324_104",
   "set": "recitation",
   "text": "日刊センティナル紙のヘプバンです。"
  },
  {
   "id": "RECITATION324_105",
   "set": "recitation",
   "text": "この宝石は、ひとつ百万円以上のお値段です。"
  },
  {
   "id": "RECITATION324_106",
   "set": "recitation",
   "text": "チョウチョと仲良くなるんだから。"
  },
  {
   "id": "RECITATION324_107",
   "set": "recitation",
   "text": "宇宙では、エントロピーは無際限に増大している。"
  },
  {
   "id": "RECITATION324_108",
   "set": "recitation",
   "text": "川の中流に集落がある。"
  },
  {
   "id": "RECITATION324_109",
   "set": "recitation",
   "text": "是非お話させて頂きたいと思います。"
  },
  {
   "id": "RECITATION324_110",
   "set": "recitation",
   "text": "お隣さんが蒟蒻を持っていらっしゃる。"
  },
  {
   "id": "RECITATION324_111",
   "set": "recitation",
   "text": "パーティーは楽しむものです。"
  },
  {
   "id": "RECITATION324_112",
   "set": "recitation",
   "text": "おてつと大きく書かれた番茶茶碗は、これらの人々の前に置かれた。"
  },
  {
   "id": "RECITATION324_113",
   "set": "recitation",
   "text": "私のポケットの中には携帯電話が入っています。"
  },
  {
   "id": "RECITATION324_114",
   "set": "recitation",
   "text": "彼は今度は牧場へ行って、沼地で小悪魔の尻尾一つ見つけました。"
  },
  {
   "id": "RECITATION324_115",
   "set": "recitation",
   "text": "五行説による占いがあるという情報あり。"
  },
  {
   "id": "RECITATION324_116",
   "set": "recitation",
   "text": "テンプル君、既に真逆だと言った。"
  },
  {
   "id": "RECITATION324_117",
   "set": "recitation",
   "text": "世界中の様々なモニュメントを訪ね歩いた。"
  },
  {
   "id": "RECITATION324_118",
   "set": "recitation",
   "text": "アンソニー・ホプキンスは有名な俳優です。"
  },
  {
   "id": "RECITATION324_119",
   "set": "recitation",
   "text": "彼女は出来るだけぴったりと耳をあてて聴きました。"
  },
  {
   "id": "RECITATION324_120",
   "set": "recitation",
   "text": "茶一つ参らぬか、まあいいで。"
  },
  {
   "id": "RECITATION324_121",
   "set": "recitation",
   "text": "ボヤですんでよかった。"
  },
  {
   "id": "RECITATION324_122",
   "set": "recitation",
   "text": "モンタギュ・ゴーシ卿がマンチェスターに来た。"
  },
  {
   "id": "RECITATION324_123",
   "set": "recitation",
   "text": "ウィスキーの水割りをガッツリ飲んだ。"
  },
  {
   "id": "RECITATION324_124",
   "set": "recitation",
   "text": "これやお祭りを若いものに見せるにゃ持ってこいだ。"
  },
  {
   "id": "RECITATION324_125",
   "set": "recitation",
   "text": "私はイメージカラーをピンクに決めた。"
  },
  {
   "id": "RECITATION324_126",
   "set": "recitation",
   "text": "ムニャムニャ、もう食べれません。"
  },
  {
   "id": "RECITATION324_127",
   "set": "recitation",
   "text": "満洲は雨季以外には雨が少ないと言われているが、わたしが満洲にあるあいだは、大戦中のせいか、ずいぶん雨が多かった。"
  },
  {
   "id": "RECITATION324_128",
   "set": "recitation",
   "text": "均一居酒屋では一番売れても二人で八千円くらいだ。"
  },
  {
   "id": "RECITATION324_129",
   "set": "recitation",
   "text": "願いをかなえる。"
  },
  {
   "id": "RECITATION324_130",
   "set": "recitation",
   "text": "最初辛かったけど、花や園芸が好きだったから、失意が癒やされないこともない。"
  },
  {
   "id": "RECITATION324_131",
   "set": "recitation",
   "text": "ペピス爺さんはもう寝るらしい。"
  },
  {
   "id": "RECITATION324_132",
   "set": "recitation",
   "text": "直ぐウィルキンソンを呼びに行け。"
  },
  {
   "id": "RECITATION324_133",
   "set": "recitation",
   "text": "お昼前ジャスパーさん宅へ再びお邪魔しました。"
  },
  {
   "id": "RECITATION324_134",
   "set": "recitation",
   "text": "その竜の百の頭が恐ろしい。"
  },
  {
   "id": "RECITATION324_135",
   "set": "recitation",
   "text": "必要なミョウバンの量はプリントに書いてあります。"
  },
  {
   "id": "RECITATION324_136",
   "set": "recitation",
   "text": "マリー・ロジェはパヴェサンタンの家を出た。"
  },
  {
   "id": "RECITATION324_137",
   "set": "recitation",
   "text": "読み進むにつれ、ますます興味が湧いた。"
  },
  {
   "id": "RECITATION324_138",
   "set": "recitation",
   "text": "笑いかけながら一二歩近寄った。"
  },
  {
   "id": "RECITATION324_139",
   "set": "recitation",
   "text": "地表を緑化して、温暖化を抑止する能力を強くする。"
  },
  {
   "id": "RECITATION324_140",
   "set": "recitation",
   "text": "ハサミでプツッと切った切れ端をペットにあげた。"
  },
  {
   "id": "RECITATION324_141",
   "set": "recitation",
   "text": "ホームランを打つ。"
  },
  {
   "id": "RECITATION324_142",
   "set": "recitation",
   "text": "プレゼントをギャロウェイさんに渡してください。"
  },
  {
   "id": "RECITATION324_143",
   "set": "recitation",
   "text": "ケプラーの法則について直接私に聞いてきた。"
  },
  {
   "id": "RECITATION324_144",
   "set": "recitation",
   "text": "ウェンディーズはハンバーガー屋さんです。"
  },
  {
   "id": "RECITATION324_145",
   "set": "recitation",
   "text": "しかし氷河はアルプスだけにあるものではない。"
  },
  {
   "id": "RECITATION324_146",
   "set": "recitation",
   "text": "この先百年も抹茶は衰退しない。"
  },
  {
   "id": "RECITATION324_147",
   "set": "recitation",
   "text": "自分を評価するのは会社であって、行き過ぎた自己表現は失脚につながる。"
  },
  {
   "id": "RECITATION324_148",
   "set": "recitation",
   "text": "夜に吹く風のヒュウヒュウという音が私を不安にさせる。"
  },
  {
   "id": "RECITATION324_149",
   "set": "recitation",
   "text": "可愛い華奢な女の子。"
  },
  {
   "id": "RECITATION324_150",
   "set": "recitation",
   "text": "水中の金魚をすくうためのポイ。"
  },
  {
   "id": "RECITATION324_151",
   "set": "recitation",
   "text": "グレンエルギンはウィスキーの蒸留所です。"
  },
  {
   "id": "RECITATION324_152",
   "set": "recitation",
   "text": "一寸法師が、ヒョコヒョコと彼の方へ近づいた。"
  },
  {
   "id": "RECITATION324_153",
   "set": "recitation",
   "text": "連中はリビングでぺちゃくちゃ喋って、警戒していない。"
  },
  {
   "id": "RECITATION324_154",
   "set": "recitation",
   "text": "平一郎はシャツ一枚になって絹物の布団の中へ潜りこんだ。"
  },
  {
   "id": "RECITATION324_155",
   "set": "recitation",
   "text": "下京区に引っ越す。"
  },
  {
   "id": "RECITATION324_156",
   "set": "recitation",
   "text": "彼の言葉に一種不思議な感覚を覚えた。"
  },
  {
   "id": "RECITATION324_157",
   "set": "recitation",
   "text": "この事業所には百人以上の人が勤めています。"
  },
  {
   "id": "RECITATION324_158",
   "set": "recitation",
   "text": "わたしの家ばかりでなく、近所の住居といわず、商店といわず、バラックの家々ではみな草花を植えている。"
  },
  {
   "id": "RECITATION324_159",
   "set": "recitation",
   "text": "どうせ私は馬の世話をせにゃならんから、外へ行こう。"
  },
  {
   "id": "RECITATION324_160",
   "set": "recitation",
   "text": "ヤン・セチャンというお笑い芸人。"
  },
  {
   "id": "RECITATION324_161",
   "set": "recitation",
   "text": "男が妙な顔をして、一瞬残忍になった。"
  },
  {
   "id": "RECITATION324_162",
   "set": "recitation",
   "text": "普及活動に幻滅した。"
  },
  {
   "id": "RECITATION324_163",
   "set": "recitation",
   "text": "雨がぽつぽつ降りだした。"
  },
  {
   "id": "RECITATION324_164",
   "set": "recitation",
   "text": "ペリウィンクルやプランティンはブルーアイです。"
  },
  {
   "id": "RECITATION324_165",
   "set": "recitation",
   "text": "姫や侍女たちが、キンポウゲやタンポポの花を持って、彼の方へ駆け寄っていった。"
  },
  {
   "id": "RECITATION324_166",
   "set": "recitation",
   "text": "皆の協力のおかげで帰郷できた。"
  },
  {
   "id": "RECITATION324_167",
   "set": "recitation",
   "text": "ウォルターとウォードが入室すると、ノラが真っ赤になった。"
  },
  {
   "id": "RECITATION324_168",
   "set": "recitation",
   "text": "今の持ち札ではあがれずに終わる。"
  },
  {
   "id": "RECITATION324_169",
   "set": "recitation",
   "text": "勉強中は話しかけないで。"
  },
  {
   "id": "RECITATION324_170",
   "set": "recitation",
   "text": "レパードの花壇が枯れ果てた。"
  },
  {
   "id": "RECITATION324_171",
   "set": "recitation",
   "text": "蒸留酒にミョウバンを加える。"
  },
  {
   "id": "RECITATION324_172",
   "set": "recitation",
   "text": "取っつきにくい女中が三人いる。"
  },
  {
   "id": "RECITATION324_173",
   "set": "recitation",
   "text": "レインボーブリッジは東京の名所。"
  },
  {
   "id": "RECITATION324_174",
   "set": "recitation",
   "text": "卑怯者は悪党です。"
  },
  {
   "id": "RECITATION324_175",
   "set": "recitation",
   "text": "突然海へ飛び込んだ。"
  },
  {
   "id": "RECITATION324_176",
   "set": "recitation",
   "text": "仕事はどっさりとあります。"
  },
  {
   "id": "RECITATION324_177",
   "set": "recitation",
   "text": "葉巻パイプはありましたか。"
  },
  {
   "id": "RECITATION324_178",
   "set": "recitation",
   "text": "八百屋に行って百円で大根を買った。"
  },
  {
   "id": "RECITATION324_179",
   "set": "recitation",
   "text": "般若とは鬼女の能面の事です。"
  },
  {
   "id": "RECITATION324_180",
   "set": "recitation",
   "text": "日本へ行くには船か飛行機が必要です。"
  },
  {
   "id": "RECITATION324_181",
   "set": "recitation",
   "text": "しかしパーで回るのも難しい。"
  },
  {
   "id": "RECITATION324_182",
   "set": "recitation",
   "text": "のぼせないように入浴するにはお湯の量と温度が大事。"
  },
  {
   "id": "RECITATION324_183",
   "set": "recitation",
   "text": "鬼太郎くんは冗談半分で盗みに入って怪我をした。"
  },
  {
   "id": "RECITATION324_184",
   "set": "recitation",
   "text": "バーニ医師がピシッと答えた。"
  },
  {
   "id": "RECITATION324_185",
   "set": "recitation",
   "text": "男の妙な動きが怪しい。"
  },
  {
   "id": "RECITATION324_186",
   "set": "recitation",
   "text": "私の病気は先天性なのです。"
  },
  {
   "id": "RECITATION324_187",
   "set": "recitation",
   "text": "三国志の関羽という将軍はすごく有名です。"
  },
  {
   "id": "RECITATION324_188",
   "set": "recitation",
   "text": "過酷な業務に耐える。"
  },
  {
   "id": "RECITATION324_189",
   "set": "recitation",
   "text": "町の女房らしい二人連れが、日傘を持って入ってきた。"
  },
  {
   "id": "RECITATION324_190",
   "set": "recitation",
   "text": "名をツァウォツキイといった。"
  },
  {
   "id": "RECITATION324_191",
   "set": "recitation",
   "text": "飲み会の参加を拒否した。"
  },
  {
   "id": "RECITATION324_192",
   "set": "recitation",
   "text": "夫人が仰天したのも無理はない。"
  },
  {
   "id": "RECITATION324_193",
   "set": "recitation",
   "text": "セファドールはめまいを抑える薬です。"
  },
  {
   "id": "RECITATION324_194",
   "set": "recitation",
   "text": "明の一訓詁学者は、宋代典籍の一つにあげてある茶せんの形状を思い起こすに苦しんでいる。"
  },
  {
   "id": "RECITATION324_195",
   "set": "recitation",
   "text": "深海魚は見た目は悪いがおいしいことが多い。"
  },
  {
   "id": "RECITATION324_196",
   "set": "recitation",
   "text": "ニューヨークでイヴニングポストの記事に注目した。"
  },
  {
   "id": "RECITATION324_197",
   "set": "recitation",
   "text": "確かに牛乳とコーンフレークの相性は抜群だ。"
  },
  {
   "id": "RECITATION324_198",
   "set": "recitation",
   "text": "その一は、明治三十七年の九月八日か九日の夜とおぼえている。"
  },
  {
   "id": "RECITATION324_199",
   "set": "recitation",
   "text": "マルメゾンの店主はジェシーとは仲良しだ。"
  },
  {
   "id": "RECITATION324_200",
   "set": "recitation",
   "text": "釣竿を肩にかけた処士あり。"
  },
  {
   "id": "RECITATION324_201",
   "set": "recitation",
   "text": "最新鋭機に乗り込む。"
  },
  {
   "id": "RECITATION324_202",
   "set": "recitation",
   "text": "誰かが後ろへ来て、変な声で叫んだのでぞっとした。"
  },
  {
   "id": "RECITATION324_203",
   "set": "recitation",
   "text": "おおでらの石段の前に立ち止まって、その出て来るのを待ちあわせた。"
  },
  {
   "id": "RECITATION324_204",
   "set": "recitation",
   "text": "未解決の懸案を持って重役と対峙する。"
  },
  {
   "id": "RECITATION324_205",
   "set": "recitation",
   "text": "薄月の光が庭を照らす。"
  },
  {
   "id": "RECITATION324_206",
   "set": "recitation",
   "text": "犯人がどっちの部屋へ入ったかわからない。"
  },
  {
   "id": "RECITATION324_207",
   "set": "recitation",
   "text": "渓谷から出た氷河が一本に合流する。"
  },
  {
   "id": "RECITATION324_208",
   "set": "recitation",
   "text": "ディスカッションを進める。"
  },
  {
   "id": "RECITATION324_209",
   "set": "recitation",
   "text": "九頭竜明神を祭るために灯篭をながす。"
  },
  {
   "id": "RECITATION324_210",
   "set": "recitation",
   "text": "今回の資料作りは深い思慮を必要としたが、先日やっと終了した。"
  },
  {
   "id": "RECITATION324_211",
   "set": "recitation",
   "text": "骨子をしっかりと組み立てる。"
  },
  {
   "id": "RECITATION324_212",
   "set": "recitation",
   "text": "気球にのって空を楽しむ。"
  },
  {
   "id": "RECITATION324_213",
   "set": "recitation",
   "text": "批評ばかりでなく対案も出すべき。"
  },
  {
   "id": "RECITATION324_214",
   "set": "recitation",
   "text": "かれらは幕のあいだに木戸の外を散歩しているのである。"
  },
  {
   "id": "RECITATION324_215",
   "set": "recitation",
   "text": "過去の数々の奇病が治るようになりつつある。"
  },
  {
   "id": "RECITATION324_216",
   "set": "recitation",
   "text": "購入者はポンプの修理が必要なことに気がついた。"
  },
  {
   "id": "RECITATION324_217",
   "set": "recitation",
   "text": "彼自身は、レジ業務につきたいと思っている。"
  },
  {
   "id": "RECITATION324_218",
   "set": "recitation",
   "text": "地毛は金色なんです。"
  },
  {
   "id": "RECITATION324_219",
   "set": "recitation",
   "text": "鉛筆は折れやすくて不便です。"
  },
  {
   "id": "RECITATION324_220",
   "set": "recitation",
   "text": "ヒポクラテスは医学の父と呼ばれます。"
  },
  {
   "id": "RECITATION324_221",
   "set": "recitation",
   "text": "ところが商人は、国ざかいのすぐ近くへ住まって、やはり前と同じようにやっています。"
  },
  {
   "id": "RECITATION324_222",
   "set": "recitation",
   "text": "今まで明るかった二階の窓は、急にまっくらになってしまいました。"
  },
  {
   "id": "RECITATION324_223",
   "set": "recitation",
   "text": "アスファルトに囲まれた中にケヤキの木が一本。"
  },
  {
   "id": "RECITATION324_224",
   "set": "recitation",
   "text": "名札を用意する。"
  },
  {
   "id": "RECITATION324_225",
   "set": "recitation",
   "text": "マッチョな男性はモテるそう。"
  },
  {
   "id": "RECITATION324_226",
   "set": "recitation",
   "text": "社務所の人の話に嘘はなかった。"
  },
  {
   "id": "RECITATION324_227",
   "set": "recitation",
   "text": "行楽シーズンの京都は人でいっぱい。"
  },
  {
   "id": "RECITATION324_228",
   "set": "recitation",
   "text": "どこからかパチパチと音が聞こえる。"
  },
  {
   "id": "RECITATION324_229",
   "set": "recitation",
   "text": "プロ野球はどのチームが優勝するだろう？"
  },
  {
   "id": "RECITATION324_230",
   "set": "recitation",
   "text": "しかし、これではまるで私が誘拐しましたと自首して出るようなもので、そんな馬鹿なことをするやつはあるまい。"
  },
  {
   "id": "RECITATION324_231",
   "set": "recitation",
   "text": "切望しつつ、主を待つ。"
  },
  {
   "id": "RECITATION324_232",
   "set": "recitation",
   "text": "しばらくしてパチパチという音も止んだ。"
  },
  {
   "id": "RECITATION324_233",
   "set": "recitation",
   "text": "身分をわきまえず放った狂言。"
  },
  {
   "id": "RECITATION324_234",
   "set": "recitation",
   "text": "天を翔ける竜の姿は神秘的だ。"
  },
  {
   "id": "RECITATION324_235",
   "set": "recitation",
   "text": "私の精神と一脈相通じるものがあると思いました。"
  },
  {
   "id": "RECITATION324_236",
   "set": "recitation",
   "text": "皆も球場に行きましょう。"
  },
  {
   "id": "RECITATION324_237",
   "set": "recitation",
   "text": "コペルニクスはポーランドの天文学者です。"
  },
  {
   "id": "RECITATION324_238",
   "set": "recitation",
   "text": "海沿いの旅館は眺めがいい。"
  },
  {
   "id": "RECITATION324_239",
   "set": "recitation",
   "text": "集中すると周りが見えない。"
  },
  {
   "id": "RECITATION324_240",
   "set": "recitation",
   "text": "春木座は今日の本郷座である。"
  },
  {
   "id": "RECITATION324_241",
   "set": "recitation",
   "text": "私の手を引っ張るようにして、手のひらへくれました。"
  },
  {
   "id": "RECITATION324_242",
   "set": "recitation",
   "text": "北海の荒波は、その氷の絶壁の根を噛んで、激しく飛沫を散らしている。"
  },
  {
   "id": "RECITATION324_243",
   "set": "recitation",
   "text": "戦意を喪失させるのが勝利への近道。"
  },
  {
   "id": "RECITATION324_244",
   "set": "recitation",
   "text": "がちょうを飼う。"
  },
  {
   "id": "RECITATION324_245",
   "set": "recitation",
   "text": "ふぁふぁと笑いながら楽しく手拍子。"
  },
  {
   "id": "RECITATION324_246",
   "set": "recitation",
   "text": "従軍記者は大尉相当の待遇を受ける。"
  },
  {
   "id": "RECITATION324_247",
   "set": "recitation",
   "text": "茶碗にかかるほど、シャツの袖のふくらかなので、掻き抱く体に茶碗を持った。"
  },
  {
   "id": "RECITATION324_248",
   "set": "recitation",
   "text": "色々隠して今日まで犯人と共にいる。"
  },
  {
   "id": "RECITATION324_249",
   "set": "recitation",
   "text": "浦子は寝ながら息を引いた。"
  },
  {
   "id": "RECITATION324_250",
   "set": "recitation",
   "text": "兄が邪険にされた。"
  },
  {
   "id": "RECITATION324_251",
   "set": "recitation",
   "text": "彼は不服そうに呟いた。"
  },
  {
   "id": "RECITATION324_252",
   "set": "recitation",
   "text": "摸造品ばかりでなく、本物のドイツ将校や兵卒のヘルメットを売っているのもある。"
  },
  {
   "id": "RECITATION324_253",
   "set": "recitation",
   "text": "彼女と一緒にいると落ち着きます。"
  },
  {
   "id": "RECITATION324_254",
   "set": "recitation",
   "text": "困ってる人に向けて寄付をしました。"
  },
  {
   "id": "RECITATION324_255",
   "set": "recitation",
   "text": "落ち込んでいるのか、うつむいてじっとしている。"
  },
  {
   "id": "RECITATION324_256",
   "set": "recitation",
   "text": "改良が進むとパンはどんどんおいしくなる。"
  },
  {
   "id": "RECITATION324_257",
   "set": "recitation",
   "text": "こんなことを言いながら、気の短いおじいさんは下駄を突っかけて、そそくさと出て行ってしまった。"
  },
  {
   "id": "RECITATION324_258",
   "set": "recitation",
   "text": "彼女と初デートの今日は夢うつつ。"
  },
  {
   "id": "RECITATION324_259",
   "set": "recitation",
   "text": "おなじ東京の名をよぶにも、今後はおそらく旧東京と新東京とに区別されるであろう。"
  },
  {
   "id": "RECITATION324_260",
   "set": "recitation",
   "text": "腰振りを二分間続ける。"
  },
  {
   "id": "RECITATION324_261",
   "set": "recitation",
   "text": "臆病者が逃げ出した。"
  },
  {
   "id": "RECITATION324_262",
   "set": "recitation",
   "text": "絵葉書と一緒に銀色のルアーをマッシュに送った。"
  },
  {
   "id": "RECITATION324_263",
   "set": "recitation",
   "text": "オムライスにはケチャップが一番。"
  },
  {
   "id": "RECITATION324_264",
   "set": "recitation",
   "text": "ストレスは適度に発散しましょう。"
  },
  {
   "id": "RECITATION324_265",
   "set": "recitation",
   "text": "この人よりぞ始まりける。"
  },
  {
   "id": "RECITATION324_266",
   "set": "recitation",
   "text": "中学生の時、避暑旅行中に体調を崩した。"
  },
  {
   "id": "RECITATION324_267",
   "set": "recitation",
   "text": "軍医は病院の門に入るのである。"
  },
  {
   "id": "RECITATION324_268",
   "set": "recitation",
   "text": "一日中明るい白夜は、一切太陽が沈まないことで起こります。"
  },
  {
   "id": "RECITATION324_269",
   "set": "recitation",
   "text": "もう、あなたにばかりも精一杯、誰にも見せられます体ではないんです。"
  },
  {
   "id": "RECITATION324_270",
   "set": "recitation",
   "text": "みんな揃って海に飛び込んだ。"
  },
  {
   "id": "RECITATION324_271",
   "set": "recitation",
   "text": "なんだそりゃ、到底無理なお願いだ。"
  },
  {
   "id": "RECITATION324_272",
   "set": "recitation",
   "text": "腸チフスは怖い病気。"
  },
  {
   "id": "RECITATION324_273",
   "set": "recitation",
   "text": "排球はバレーボールの事です。"
  },
  {
   "id": "RECITATION324_274",
   "set": "recitation",
   "text": "マッチを買いに入ったのかな。"
  },
  {
   "id": "RECITATION324_275",
   "set": "recitation",
   "text": "盆栽は風情がある。"
  },
  {
   "id": "RECITATION324_276",
   "set": "recitation",
   "text": "やがて陪審員は合議をするために法廷を出て行った。"
  },
  {
   "id": "RECITATION324_277",
   "set": "recitation",
   "text": "芸術の求める永遠性に疑問を感じる。"
  },
  {
   "id": "RECITATION324_278",
   "set": "recitation",
   "text": "聞きつけて、件の嫗、ぶるぶるとかぶりをふった。"
  },
  {
   "id": "RECITATION324_279",
   "set": "recitation",
   "text": "キェルツェを通ってドビェに、ザリピェからミェイに行く。"
  },
  {
   "id": "RECITATION324_280",
   "set": "recitation",
   "text": "マリアーンスケー・ラーズニェを訪れる。"
  },
  {
   "id": "RECITATION324_281",
   "set": "recitation",
   "text": "乳牛を見ながら、レテュの入ったピッツァを食べる。"
  },
  {
   "id": "RECITATION324_282",
   "set": "recitation",
   "text": "ウドゥの奏者を施療した。"
  },
  {
   "id": "RECITATION324_283",
   "set": "recitation",
   "text": "インスティテュートで、リデュースの話と併せて、ルデュックの話も聞いた。"
  },
  {
   "id": "RECITATION324_284",
   "set": "recitation",
   "text": "ギェナーを見てイェーイと叫ぶ。"
  },
  {
   "id": "RECITATION324_285",
   "set": "recitation",
   "text": "スィーディーを聞きながら、でゃーこんを食べる。"
  },
  {
   "id": "RECITATION324_286",
   "set": "recitation",
   "text": "テョさんはズィーブラを見た。"
  },
  {
   "id": "RECITATION324_287",
   "set": "recitation",
   "text": "レヴォリューション。レギュレーション。エデュケーション。"
  },
  {
   "id": "RECITATION324_288",
   "set": "recitation",
   "text": "ブレンドデョート。ラーテャン。"
  },
  {
   "id": "RECITATION324_289",
   "set": "recitation",
   "text": "あっあの。いっいえ。えっえぇ。おっおい。んーとね。"
  },
  {
   "id": "RECITATION324_290",
   "set": "recitation",
   "text": "いぶかしげに見上げた雨雲から、琥珀色のドラゴンがギュンと現れた。"
  },
  {
   "id": "RECITATION324_291",
   "set": "recitation",
   "text": "布でギュギュっとヌンチャクを縛る。"
  },
  {
   "id": "RECITATION324_292",
   "set": "recitation",
   "text": "服を脱ぐが、いつも上下が逆さまだ。"
  },
  {
   "id": "RECITATION324_293",
   "set": "recitation",
   "text": "放課後の音楽室で、高音を頑張って出した。"
  },
  {
   "id": "RECITATION324_294",
   "set": "recitation",
   "text": "モゴモゴしながら言うギャグは面白くない。"
  },
  {
   "id": "RECITATION324_295",
   "set": "recitation",
   "text": "海水魚の漁業の一環として、稚魚が育てられている。"
  },
  {
   "id": "RECITATION324_296",
   "set": "recitation",
   "text": "ムンムンとした熱気に、あの淡水魚もへとへとになっている。"
  },
  {
   "id": "RECITATION324_297",
   "set": "recitation",
   "text": "ヘスティア所長は、十二音音楽の作法を知っている。"
  },
  {
   "id": "RECITATION324_298",
   "set": "recitation",
   "text": "主催者は、このフェスのキャパが小さいことを、セシルから聞いた。"
  },
  {
   "id": "RECITATION324_299",
   "set": "recitation",
   "text": "母は、サフランライスと、さつまいもの入ったシチューと、ポトフをハフハフしながら食べた。"
  },
  {
   "id": "RECITATION324_300",
   "set": "recitation",
   "text": "そして、左京と千紗はヘファ駅に着いた。"
  },
  {
   "id": "RECITATION324_301",
   "set": "recitation",
   "text": "根本と曽原は主君を批判した。"
  },
  {
   "id": "RECITATION324_302",
   "set": "recitation",
   "text": "ケケっと笑いながら、津原はパトカーに乗った。"
  },
  {
   "id": "RECITATION324_303",
   "set": "recitation",
   "text": "キュキュッと鳴らした靴でパスを出した。"
  },
  {
   "id": "RECITATION324_304",
   "set": "recitation",
   "text": "ティファニーはパピーにムギュッと抱き着きながら、チュチュッとキスをし、センキュと言った。"
  },
  {
   "id": "RECITATION324_305",
   "set": "recitation",
   "text": "その義軍は、一ヘクタールほふく前進をした。"
  },
  {
   "id": "RECITATION324_306",
   "set": "recitation",
   "text": "へへっと、きゃつは媚びへつらった。"
  },
  {
   "id": "RECITATION324_307",
   "set": "recitation",
   "text": "ほとんどの被調査者は、写真を車載した。"
  },
  {
   "id": "RECITATION324_308",
   "set": "recitation",
   "text": "補佐が、一酸化炭素中毒になるというハプニングは起きなかった。"
  },
  {
   "id": "RECITATION324_309",
   "set": "recitation",
   "text": "スチューデントが被災するファクターを、可能な限り取り払う。"
  },
  {
   "id": "RECITATION324_310",
   "set": "recitation",
   "text": "カフェとは、ブレックファストとして、フォカッチャを食べれる場所でもある。"
  },
  {
   "id": "RECITATION324_311",
   "set": "recitation",
   "text": "普通、初級者では、高音を伸ばすことはできない。"
  },
  {
   "id": "RECITATION324_312",
   "set": "recitation",
   "text": "彼からしたら、左中間から見る景色は貴重だった。"
  },
  {
   "id": "RECITATION324_313",
   "set": "recitation",
   "text": "シェパードと同居中に、フォスターはその格付け表を見た。"
  },
  {
   "id": "RECITATION324_314",
   "set": "recitation",
   "text": "去々年、虚数とヘ長調について学んだ。"
  },
  {
   "id": "RECITATION324_315",
   "set": "recitation",
   "text": "脚立の上でヒュヒューと風が吹くと、彼は背筋を伸ばした。"
  },
  {
   "id": "RECITATION324_316",
   "set": "recitation",
   "text": "昼にはペスカトーレを、夜には寿司をパクパク食べた。"
  },
  {
   "id": "RECITATION324_317",
   "set": "recitation",
   "text": "ケフィアに関するこの本は、初版では三百部くらいだったが、次から波及的に増加した。"
  },
  {
   "id": "RECITATION324_318",
   "set": "recitation",
   "text": "皮膚が私のフェチである。"
  },
  {
   "id": "RECITATION324_319",
   "set": "recitation",
   "text": "社販で巨富を築くという、彼の目論見は途中でへし折られた。"
  },
  {
   "id": "RECITATION324_320",
   "set": "recitation",
   "text": "左表のとおりの支出になることが、ある意味わが社の社風である。"
  },
  {
   "id": "RECITATION324_321",
   "set": "recitation",
   "text": "この古風な酒瓢は故郷のものだ。"
  },
  {
   "id": "RECITATION324_322",
   "set": "recitation",
   "text": "そのほつれが腐敗しているというのは、誇張した表現だと思う。"
  },
  {
   "id": "RECITATION324_323",
   "set": "recitation",
   "text": "その映画の出演者である彼が、主犯である可能性はフィフティーフィフティーだ。"
  },
  {
   "id": "RECITATION324_324",
   "set": "recitation",
   "text": "チュクンの波長は、パツンと共通している。"
  }
 ]
}
