<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Hardened Runtime Permissions -->
    <!-- Required for Electron to function under Hardened Runtime (Notarization) -->
    <!-- Note: App is not sandboxed, so sandbox-related entitlements are not needed -->

    <!-- Allow JIT compilation (required by V8 JS engine) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required by Electron) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation (required to load third-party dylibs/plugins) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow DYLD environment variables (helps with command execution and PATH resolution) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Allow execution of external commands -->
    <!-- Required for running ffmpeg and ffprobe installed on the user's system -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
      <string>com.apple.coreservices.launchservicesd</string>
    </array>

    <!-- Allow reading and writing files chosen by the user through open/save dialogs -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Note on file access:
         The app is not sandboxed, so file access is governed by macOS TCC rather than
         entitlements. Reading protected locations (Desktop, Documents, Downloads,
         removable and network volumes) requires the user to grant Full Disk Access in
         System Settings; the Cleanup screen shows a notice when it has not been granted.
         The usage description strings shown in the TCC prompts are defined in
         electron-builder.yml (mac.extendInfo).
         App configuration is stored in ~/.kura_toolkit, which needs no special permission. -->
  </dict>
</plist>
